{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devkit",
  "main": "./src/index.ts",
  "workers_dev": false,
  "account_id": "7416e7b5d307baabca87e8fba69158e5",
  "compatibility_date": "2026-04-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/webhook/*",
      "/oauth/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forum",
      "database_id": "5aa63fdc-078b-482d-b61f-9c55e955cdb5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "agentr2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "LiveSession",
        "name": "LiveSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LiveSession"
      ]
    }
  ]
}
