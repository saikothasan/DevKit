{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["./worker-configuration.d.ts", "vite/client", "node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/index.ts",
    "src/routes/**/*.ts",
    "src/do/**/*.ts",
    "src/db/**/*.ts",
    "src/utils/**/*.ts"
  ],
  "exclude": [
    "src/pages/**/*.tsx",
    "src/components/**/*.tsx",
    "src/context/**/*.tsx",
    "src/hooks/**/*.ts",
    "src/main.tsx",
    "src/App.tsx"
  ]
}
